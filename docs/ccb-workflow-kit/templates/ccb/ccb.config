# CCB project configuration — no account, key, token, URL, or real path.
# Copy to <project>/.ccb/ccb.config and adjust model names to the owner's account.
version = 2
entry_window = "main"

[windows]
main = "main:codex"
review = "reviewer:codex"
workers = "developer:claude(worktree), knowledge_keeper:claude"
scouts = "task_scout:claude, explorer:claude, utility:claude"
# Optional standalone provider panes. Delete either line if its CLI is not installed.
codex = "codex:codex"
claude = "claude:claude"
opencode = "opencode:opencode"

[ui.sidebar]
agents_height = "50%"
comms_height = "15%"
tips_height = "35%"

# Use only model IDs and arguments verified by the current account.
[agents.main]
model = "gpt-5.6-sol"
thinking = "medium"
startup_args = ["-c", "service_tier=\"default\"", "-c", "features.fast_mode=false"]

[agents.reviewer]
model = "gpt-5.6-sol"
thinking = "medium"
startup_args = ["-c", "service_tier=\"default\"", "-c", "features.fast_mode=false"]

[agents.developer]
model = "opus"
startup_args = ["--effort", "max"]

[agents.knowledge_keeper]
model = "opus"
startup_args = ["--effort", "max"]

[agents.task_scout]
model = "opus"
startup_args = ["--effort", "max"]

[agents.explorer]
model = "opus"
startup_args = ["--effort", "max"]

[agents.utility]
model = "opus"
startup_args = ["--effort", "max"]
